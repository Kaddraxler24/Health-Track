<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher_foreground" android:scaleType="centerCrop" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/w_inj" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#F5A59B" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Injection : —" />
    <TextView android:id="@+id/w_basdai" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="BASDAI : —" />
    <TextView android:id="@+id/w_line" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#A9A6B3" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text="" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_btn_basdai" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center"
            android:background="@drawable/widget_btn_hot" android:text="BASDAI" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_btn_morning" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center" android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn" android:text="Raideur" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_btn_temp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:gravity="center" android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn" android:text="Temp." android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
